# Supabase credentials are set in src/lib/supabase.js (the ONLY place).
# Use the publishable (anon) key only. NEVER use or commit a service_role key.
# Reference values for that file (Supabase Dashboard > Project Settings > API):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
